{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/backend/BusTicketing.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/backend/BusTicketing.Api"
      ],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "frontend",
      "type": "npm",
      "script": "dev",
      "path": "frontend/",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev",
      "dependsOn": [
        "backend",
        "frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
